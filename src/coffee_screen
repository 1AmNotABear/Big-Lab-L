#include "lpc24xx.h"
#include "delay.h"
#include "lcd/lcd_hw.h"
#include "lcd/lcd_grph.h"
#include "lcd/lcd_cfg.h"
#include "lcd/sdram.h"
#include "coffee_state.h"

// colours used for the login screen
#define BACKGROUND_COLOR  NAVY
#define TEXT_COLOR        WHITE
#define BUTTON_COLOR      DARK_GRAY
#define BORDER_COLOR      CYAN


// function declarations
void drawCoffeeScreen(void);

void drawButton(unsigned short x0, unsigned short y0, unsigned short x1, unsigned short y1, const char *label);

unsigned int getTextLength(const char *text);

void touch_read_xy(char *x, char* y, int* pressure);
void touch_init(void);
void coffeeMachine(char x, char y);

static unsigned char touch_read(unsigned char command);

int main(void)
{

    FIO2DIR |= COFFEE_STATUS;


    // setup the external memory used by the LCD
    sdramInit();

    // setup the LCD using the supplied configuration
    lcdInit(&lcd_config);

    // turn the LCD screen on
    lcdTurnOn();

    // draw the full user ID screen
    drawCoffeeScreen();

    // Initialize the touch screen
    touch_init();

    //Loop forever
	while (1) {
		//Read in X and Y coordinates
		touch_read_xy(&x,&y, &pressure);
		// Do button intended action
		if (pressure >= 15) {
            coffeeMachine(x, y);
            do {
                touch_read_xy(&x, &y, &pressure);
            } while (pressure >= 15);
        }
	}

    return 0;
}

void drawCoffeeScreen(void)
{
    // clear the screen and make the background navy
    lcd_fillScreen(BACKGROUND_COLOR);

    // display the COFFEE heading
    lcd_fontColor(TEXT_COLOR, BACKGROUND_COLOR);
    lcd_putString(120, 35, (unsigned char *)"COFFEE");


    // turn on button
    drawButton(16, 80, 222, 130, "TURN ON");

    // scehdule button
    drawButton(16, 140, 222, 190, "SCHEDULE");

    // turn off button
    drawButton(16, 200, 222, 250, "TURN OFF");

    // House icon top right
    lcd_drawRect(200, 25 , 220, 45, WHITE);
    lcd_line(200,25,210,15,WHITE);
    lcd_line(210,15,220,25,WHITE);

}

void drawButton(unsigned short x0,
                unsigned short y0,
                unsigned short x1,
                unsigned short y1,
                const char *label)
{
    unsigned int labelLength;
    unsigned short buttonWidth;
    unsigned short buttonHeight;
    unsigned short textX;
    unsigned short textY;

    // fill the inside of the button
    lcd_fillRect(x0, y0, x1, y1, BUTTON_COLOR);

    // draw the border around the button
    lcd_drawRect(x0, y0, x1, y1, BORDER_COLOR);

    // find how many characters are in the button label
    labelLength = getTextLength(label);

    // calculate the width and height of the button
    buttonWidth = x1 - x0 + 1;
    buttonHeight = y1 - y0 + 1;

    // calculate where the label should be placed
    textX = x0 + ((buttonWidth - (labelLength * 6U)) / 2U);
    textY = y0 + ((buttonHeight - 8U) / 2U);

    // display the label in the middle of the button
    lcd_fontColor(TEXT_COLOR, BUTTON_COLOR);
    lcd_putString(textX, textY, (unsigned char *)label);
}

unsigned int getTextLength(const char *text)
{
    unsigned int length;

    length = 0;

    // count each character until the end of the text
    while (text[length] != '\0')
    {
        length++;
    }

    return length;
}

void touch_read_xy(char *x, char* y, int* pressure){
    int z1 = touch_read(0xB8);
	*pressure = z1;

	//Read X co-ordinate from the touch screen controller
	*x = touch_read(0xD8);
	//Read Y co-ordinate from the touch screen controller
	*y = touch_read(0x98);
}


void touch_init(void){
    
    // Initiallizing touch screen
    PINSEL0 |= 3 << 30; // sclk
    PINSEL1 |= (3 << 2 | 3 << 4); // 0.18 = mosi, 0.17 = miso
    
    FIO0DIR |= CS_PIN;
    
    S0SPCR = 0x093C; // spif control reg
	
	S0SPCCR = 0x24;

}

static unsigned char touch_read(unsigned char command) {
	unsigned short result;

	//Set CS_TP pin low to begin SPI transmission
	FIO0CLR = CS_PIN;
	
	//Transmit command byte on MOSI, ignore MISO (full read write cycle)
	S0SPDR = command;
    while (!(S0SPSR & (1 << 7)));
    
    result = S0SPDR;
	
	//Transmit 0x00 on MOSI, read in requested result on MISO (another full read write cycle)
	S0SPDR = 0x00; 
    
    while (!(S0SPSR & (1 << 7)));
    
    result = S0SPDR;
    
	//Transmission complete, set CS_TP pin back to high
	FIO0SET = CS_PIN;
		
	//Return 8 bit result.
	return (unsigned char) result;
}	

void coffeeMachine(char x, char y) {

    //scale the coordinates to the screens resolution
    int point_x = x*240/255;
	int point_y = y*320/255; 

    //calculate the distance from the touch to each button and do corresponding action

    if (point_x > 16 && point_x < 222) {
        if (point_y >= 80 && point_y <= 130) {
            FIO2SET = COFFEE_STATUS;
        } else if (point_y >= 140 && point_y <= 190) {
            // Connect to schedule view page
        } else if (point_y >= 200 && point_y <= 250) {
            FIO2CLR = COFFEE_STATUS;
        }
    }
}